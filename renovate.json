{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "automerge": false,
  "branchConcurrentLimit": 2,
  "packageRules": [
    {
      "matchPackageNames": [
        "github.com/cilium/ebpf",
        "github.com/vishvananda/netlink"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
